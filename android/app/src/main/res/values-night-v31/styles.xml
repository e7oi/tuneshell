<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 start screen: the brand on its night colour, in both
         themes. The icon is the foreground of the launcher icon, whose motif
         fits the circle the system leaves visible. -->
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_night</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>

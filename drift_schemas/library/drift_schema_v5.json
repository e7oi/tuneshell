  "fixed_sql": [
    {
      "name": "disks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"disks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"key\" TEXT NOT NULL UNIQUE, \"label\" TEXT NOT NULL, \"kind\" INTEGER NOT NULL, \"mark_index\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "disk_folders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"disk_folders\" (\"disk_id\" INTEGER NOT NULL REFERENCES disks (id), \"relative_path\" TEXT NOT NULL, PRIMARY KEY (\"disk_id\", \"relative_path\"));"
        }
      ]
    },
    {
      "name": "tracks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tracks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"disk_id\" INTEGER NOT NULL REFERENCES disks (id), \"relative_path\" TEXT NOT NULL, \"title\" TEXT NULL, \"artist\" TEXT NULL, \"album\" TEXT NULL, \"album_artist\" TEXT NULL, \"track_number\" INTEGER NULL, \"disc_number\" INTEGER NULL, \"year\" INTEGER NULL, \"genre\" TEXT NULL, \"duration_ms\" INTEGER NULL, \"size\" INTEGER NOT NULL, \"modified_at\" INTEGER NOT NULL, \"indexed_at\" INTEGER NOT NULL, \"artwork\" TEXT NULL, \"tags_state\" INTEGER NOT NULL DEFAULT 0, UNIQUE (\"disk_id\", \"relative_path\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "playback_session",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playback_session\" (\"id\" INTEGER NOT NULL, \"current_index\" INTEGER NOT NULL, \"position_ms\" INTEGER NOT NULL, \"shuffle\" INTEGER NOT NULL CHECK (\"shuffle\" IN (0, 1)), \"repeat\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "playback_queue",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playback_queue\" (\"position\" INTEGER NOT NULL, \"disk_id\" TEXT NOT NULL, \"relative_path\" TEXT NOT NULL, \"origin_position\" INTEGER NULL, PRIMARY KEY (\"position\"));"
        }
      ]
    },
    {
      "name": "disks_mark_index",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE UNIQUE INDEX disks_mark_index ON disks (mark_index)"
        }
      ]
    }
